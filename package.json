{
  "name": "ai-native-qa-platform",
  "version": "0.1.0",
  "private": true,
  "license": "MIT",
  "type": "module",
  "packageManager": "pnpm@11.25.0",
  "engines": {
    "node": ">=24.22.2 <25"
  },
  "scripts": {
    "dev": "tsx scripts/dev.ts",
    "build": "vite build --config apps/web/vite.config.ts",
    "start": "tsx apps/server/main.ts",
    "open": "tsx scripts/open.ts",
    "demo": "tsx apps/demo/main.ts",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "tsx --test tests/*.test.ts",
    "test:smoke": "playwright test --config tests/playwright.config.ts"
  },
  "dependencies": {
    "@cucumber/gherkin": "42.0.1",
    "@cucumber/messages": "34.2.1",
    "@fastify/static": "10.1.10",
    "better-sqlite3": "13.0.3",
    "fastify": "5.12.8",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "typescript": "5.9.3"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@playwright/test": "1.65.0",
    "@types/better-sqlite3": "9.6.0",
    "@types/node": "24.19.2",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "eslint": "10.14.0",
    "playwright-bdd": "9.2.1",
    "prettier": "3.9.10",
    "tsx": "4.23.15",
    "typescript-eslint": "8.72.1",
    "vite": "8.3.6"
  }
}
